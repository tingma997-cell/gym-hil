<?xml version="1.0"?>
<robot name="so101">
  <!-- Minimal SO-101 URDF scaffold. The runnable gym-hil simulation uses the MJCF counterpart in so101.xml. -->
  <material name="so101_yellow"><color rgba="1 0.82 0.12 1"/></material>
  <material name="servo_black"><color rgba="0.1 0.1 0.1 1"/></material>

  <link name="base">
    <visual><origin xyz="0 0 0.012"/><geometry><box size="0.11 0.09 0.024"/></geometry><material name="so101_yellow"/></visual>
    <collision><origin xyz="0 0 0.012"/><geometry><box size="0.11 0.09 0.024"/></geometry></collision>
    <inertial><origin xyz="0 0 0.012"/><mass value="0.147"/><inertia ixx="0.000114686" ixy="0" ixz="0" iyy="0.000136117" iyz="0" izz="0.000130364"/></inertial>
  </link>

  <link name="shoulder">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.036 0.036 0.028"/></geometry><material name="servo_black"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><box size="0.036 0.036 0.028"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.100006"/><inertia ixx="0.000083759" ixy="0" ixz="0" iyy="0.0000810403" iyz="0" izz="0.0000239783"/></inertial>
  </link>
  <joint name="shoulder_pan" type="revolute">
    <parent link="base"/><child link="shoulder"/><origin xyz="0 0 0.072"/><axis xyz="0 0 1"/>
    <limit lower="-1.91986" upper="1.91986" effort="3.35" velocity="3.14"/>
    <dynamics damping="0.60" friction="0.052"/>
  </joint>

  <link name="upper_arm">
    <visual><origin xyz="0.07 0 0"/><geometry><cylinder radius="0.018" length="0.14"/></geometry><material name="so101_yellow"/></visual>
    <collision><origin xyz="0.07 0 0"/><geometry><cylinder radius="0.018" length="0.14"/></geometry></collision>
    <inertial><origin xyz="0.07 0 0"/><mass value="0.103"/><inertia ixx="0.0000408002" ixy="0" ixz="0" iyy="0.000147318" iyz="0" izz="0.000142487"/></inertial>
  </link>
  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder"/><child link="upper_arm"/><origin xyz="0.04 0 0.025" rpy="0 1.57079632679 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.74533" upper="1.74533" effort="3.35" velocity="3.14"/>
    <dynamics damping="0.60" friction="0.052"/>
  </joint>

  <link name="lower_arm">
    <visual><origin xyz="0.0675 0 0"/><geometry><cylinder radius="0.016" length="0.135"/></geometry><material name="so101_yellow"/></visual>
    <collision><origin xyz="0.0675 0 0"/><geometry><cylinder radius="0.016" length="0.135"/></geometry></collision>
    <inertial><origin xyz="0.0675 0 0"/><mass value="0.104"/><inertia ixx="0.0000287438" ixy="0" ixz="0" iyy="0.000159844" iyz="0" izz="0.00014529"/></inertial>
  </link>
  <joint name="elbow_flex" type="revolute">
    <parent link="upper_arm"/><child link="lower_arm"/><origin xyz="0.14 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.69" upper="1.69" effort="3.35" velocity="3.14"/>
    <dynamics damping="0.60" friction="0.052"/>
  </joint>

  <link name="wrist"><visual><origin xyz="0.0275 0 0"/><geometry><cylinder radius="0.014" length="0.055"/></geometry><material name="so101_yellow"/></visual></link>
  <joint name="wrist_flex" type="revolute">
    <parent link="lower_arm"/><child link="wrist"/><origin xyz="0.135 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.65806" upper="1.65806" effort="3.35" velocity="3.14"/>
    <dynamics damping="0.60" friction="0.052"/>
  </joint>

  <link name="gripper_roll"><visual><geometry><box size="0.036 0.036 0.028"/></geometry><material name="servo_black"/></visual></link>
  <joint name="wrist_roll" type="revolute">
    <parent link="wrist"/><child link="gripper_roll"/><origin xyz="0.055 0 0" rpy="1.57079632679 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-2.74385" upper="2.84121" effort="3.35" velocity="3.14"/>
    <dynamics damping="0.60" friction="0.052"/>
  </joint>

  <link name="gripper"><visual><origin xyz="0.018 0 0"/><geometry><box size="0.036 0.024 0.024"/></geometry><material name="so101_yellow"/></visual></link>
  <joint name="gripper" type="revolute">
    <parent link="gripper_roll"/><child link="gripper"/><origin xyz="0.035 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-0.17453" upper="1.74533" effort="3.35" velocity="3.14"/>
    <dynamics damping="0.60" friction="0.052"/>
  </joint>
</robot>
